{
  "expo": {
    "name": "HL KiddoMed",
    "slug": "hl-kiddomed",
    "scheme": "kiddomed",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0284C7"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hurtado.kiddomed"
    },
    "android": {
      "package": "com.hurtado.kiddomed",
      "adaptiveIcon": {
        "backgroundColor": "#DAF4EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8d2ba2d-dd9f-4070-839f-4e5e0a8a52bb"
      }
    },
    "owner": "hurtz27",
    "updates": {
      "url": "https://u.expo.dev/a8d2ba2d-dd9f-4070-839f-4e5e0a8a52bb"
    }
  }
}
