rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/uid_roles/$(request.auth.uid));
    }

    function isCaregiver(familyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/families/$(familyId)/uid_roles/$(request.auth.uid)).data.role == 'caregiver';
    }

    // Códigos de invitación: lectura puntual por código exacto para vincular dispositivo
    match /invites/{inviteCode} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if isSignedIn() &&
        (resource == null ? isCaregiver(request.resource.data.family_id) : isCaregiver(resource.data.family_id));
    }

    match /families/{familyId} {
      allow create: if isSignedIn();
      allow read: if isFamilyMember(familyId);
      allow update: if isCaregiver(familyId);

      // Mapeo de uid -> rol dentro de la familia
      match /uid_roles/{uid} {
        allow read: if isFamilyMember(familyId);
        // El creador de la familia o un cuidador puede asignar roles, o un usuario puede auto-vincularse si presenta invite válido
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if isCaregiver(familyId);
      }

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        // Permitir crear primer miembro al creador, o a cuidadores, o vincular su propio miembro al unirse
        allow create: if isSignedIn();
        allow update: if isCaregiver(familyId) ||
          (isSignedIn() && resource.data.invite_code != null && request.resource.data.linked_uid == request.auth.uid);
        allow delete: if isCaregiver(familyId);
      }

      match /illnesses/{illnessId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isCaregiver(familyId);
      }

      match /treatments/{treatmentId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isCaregiver(familyId);
      }

      match /dose_logs/{logId} {
        allow read: if isFamilyMember(familyId);
        // Auditoría inmutable: solo cuidadores pueden crear registros de administración
        allow create: if isCaregiver(familyId);
        allow update, delete: if false;
      }

      match /symptom_logs/{symptomId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isCaregiver(familyId);
      }
    }
  }
}
